# ─────────────────────────────────────────────────────────────
# ConnectHub environment configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string.
#   Local MongoDB : mongodb://127.0.0.1:27017/connecthub
#   MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connecthub?retryWrites=true&w=majority
#   No MongoDB installed? Set MONGO_URI=memory to run an embedded, file-persisted
#   MongoDB server (development only, powered by mongodb-memory-server).
MONGO_URI=mongodb://127.0.0.1:27017/connecthub

# Secret used to sign JWTs. Use a long random string (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret

# How long a login session lasts (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# HTTP port for the API + frontend
PORT=5000

# development | production
NODE_ENV=development

# Optional: comma-separated list of allowed origins when the frontend is hosted
# separately (e.g. http://127.0.0.1:5500). Leave empty when Express serves the client.
CLIENT_ORIGIN=
